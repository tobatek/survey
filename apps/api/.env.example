APP_NAME="myAMETA Survey"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=myameta_survey
DB_USERNAME=myameta
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Fase 6 paket D (FSD §21.1) -- KOSONGKAN/biarkan default di dev (HTTP
# lokal, cookie "secure" akan gagal terkirim kalau dipaksa true di sini).
# WAJIB diisi eksplisit di production (APP_ENV=production, selalu HTTPS):
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=myameta_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@myameta-survey.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Portal SSO integration (docs/15_SSO_PORTAL_VALIDASI_SEPARATION_PLAN.md) ---
# myAMETA Survey adalah "App Luar" terhadap Portal SSO existing.
SSO_PORTAL_BASE_URL=https://portal.example.ac.id
SSO_PORTAL_FRONTEND_URL=
SSO_APP_CLIENT_ID=
SSO_APP_TOKEN=
SSO_REDIRECT_URI="${APP_URL}/auth/callback"

# --- Survey-specific config (lihat FSD §12.2, §29) ---
SURVEY_MINIMUM_SEGMENT_SIZE=5
SURVEY_EXPORT_EXPIRY_HOURS=48

# CORS: origin SPA (apps/web) yang diizinkan mengakses API ini
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SPA_URL=http://localhost:5173
