# Template env var production untuk apps/api. JANGAN commit file .env
# sungguhan ke git -- isi nilai-nilai ini langsung di panel Environment
# Dokploy (compose "api", "queue", "scheduler" semuanya butuh set yang sama).
#
# Lihat docs/25_DEPLOYMENT_DOKPLOY.md untuk urutan setup lengkap.

APP_NAME="myAMETA Survey"
APP_ENV=production
# Generate sekali secara lokal: php artisan key:generate --show
# (jangan generate di server produksi tiap deploy -- key berubah = semua
# data terenkripsi/session lama tidak terbaca lagi)
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# Isi dengan host/kredensial dari resource "Database" Postgres di Dokploy.
DB_HOST=
DB_PORT=5432
DB_DATABASE=myameta_survey
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Kalau API & SPA beda subdomain (api-x.example.ac.id & app.example.ac.id), WAJIB
# diisi domain induk dengan titik di depan, mis. .example.ac.id -- supaya SPA bisa
# membaca cookie XSRF-TOKEN dan sesi terbagi. Biarkan null hanya kalau satu host.
SESSION_DOMAIN=null
# WAJIB true/strict di production (selalu HTTPS) -- lihat Fase 6 paket D.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=myameta_cache

REDIS_CLIENT=predis
# Isi dengan host/kredensial dari resource "Database" Redis di Dokploy.
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@myameta-survey.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Portal SSO integration (docs/15_SSO_PORTAL_VALIDASI_SEPARATION_PLAN.md) ---
# API Portal (server-to-server: /api/sso/verify), mis. https://api-portal.example.ac.id
SSO_PORTAL_BASE_URL=
# Frontend Portal (halaman /sso/authorize di browser), mis. https://portal.example.ac.id
SSO_PORTAL_FRONTEND_URL=
SSO_APP_CLIENT_ID=
SSO_APP_TOKEN=
SSO_REDIRECT_URI="${APP_URL}/auth/callback"

# --- Survey-specific config ---
SURVEY_MINIMUM_SEGMENT_SIZE=5
SURVEY_EXPORT_EXPIRY_HOURS=48

# CORS: domain publik SPA (apps/web) yang diizinkan akses API ini.
SANCTUM_STATEFUL_DOMAINS=app.example.ac.id
SPA_URL=https://app.example.ac.id
