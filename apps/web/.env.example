# Origin penuh backend Laravel (apps/api) — dipakai untuk full-page
# navigation (redirect SSO, logout) yang TIDAK bisa lewat proxy /api Vite
# karena berpindah path prefix (/auth/*, /logout, bukan /api/*).
VITE_API_ORIGIN=http://127.0.0.1:8000

# Base path untuk panggilan fetch biasa (lib/api.ts) — dibiarkan relatif
# supaya lewat proxy dev server (vite.config.ts) tanpa masalah CORS lokal.
VITE_API_BASE_URL=/api
